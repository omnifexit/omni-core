{
    "name": "omnifexit/omni-core",
    "description": "Code shared by the OmnifexIT services: encrypted queue jobs between services and the Tailscale-aware Sentinel driver.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/horizon": "^5.45",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/sentinel": "Required for the Tailscale-aware Sentinel driver (comes with laravel/horizon)."
    },
    "autoload": {
        "psr-4": {
            "Omnifexit\\OmniCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnifexit\\OmniCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omnifexit\\OmniCore\\OmniCoreServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
